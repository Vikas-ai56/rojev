<!-- World for the pick-and-place task. The robot is attached at `robot_mount` by rojev.sim.compose(). -->
<mujoco model="pick_place">
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <frame name="robot_mount" pos="0 0 0"/>
    <!-- Fixed overhead sensor camera looking straight down; image up = +x (away from the robot). -->
    <camera name="overhead" pos="0.2 0 0.85" xyaxes="0 -1 0 1 0 0" fovy="50"/>
    <!-- Fixed front (third-person) camera facing the arm across the workspace, as in LeRobot / GR00T SO-101 setups;
         the arm's own wrist_cam is the second view. -->
    <camera name="front" pos="0.6 0 0.35" xyaxes="0 1 0 -0.6 0 0.8" fovy="55"/>
    <body name="box" pos="0.2 0.12 0.03">  <!-- beside, not under, the arm's home pose -->
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003" rgba="0 1 0 1" contype="2"
        conaffinity="1" solref="0.01 1"/>
    </body>
  </worldbody>
</mujoco>
